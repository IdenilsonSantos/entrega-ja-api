# Copie para .env (ou defina no provedor). Todas têm padrão para desenvolvimento.
NODE_ENV=development
PORT=3000
# api | worker | all
APP_ROLE=all
DATABASE_URL=postgres://delivery:delivery@localhost:5432/entregaja
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
JWT_EXPIRES_IN=7d
# endereço(s) do site, separados por vírgula
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
UPLOAD_DIR=./uploads
# despacho
DISPATCH_OFFER_TTL_SEC=25
DISPATCH_RETRY_DELAY_MS=15000
DISPATCH_ALERT_AFTER=8
COURIER_PRESENCE_TTL_SEC=60
# rotas (melhor caminho): osrm | mapbox | none. O OSRM público é só para testes.
ROUTING_PROVIDER=osrm
ROUTING_URL=https://router.project-osrm.org
MAPBOX_TOKEN=
# Web Push (npx web-push generate-vapid-keys). Vazio = gera um par e guarda no Redis.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@entregaja.dev
# Push do app nativo (opcional)
EXPO_ACCESS_TOKEN=
# E-mail: log (só console) | resend | smtp (SES, SendGrid, Postmark, Brevo, Mailpit...)
MAIL_PROVIDER=log
MAIL_FROM=Entrega Já <nao-responda@entregaja.dev>
RESEND_API_KEY=
# smtp://usuario:senha@host:587 ou smtps://usuario:senha@host:465 (Mailpit local: smtp://localhost:1025)
SMTP_URL=
# validade do link de "esqueci minha senha"
PASSWORD_RESET_TTL_MIN=60
# limite geral de requisições por IP (login, cadastro e senha têm limites próprios)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=600
